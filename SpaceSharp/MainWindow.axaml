<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SpaceSharp.Controls"
        x:Class="SpaceSharp.MainWindow"
        Title="SpaceSharp"
        Width="1400" Height="880" MinWidth="1040" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="avares://SpaceSharp/Assets/SpaceSharp.ico"
        Background="{DynamicResource Window}">

  <!-- The main window, laid out as the WPF app's (2.2): top bar, path row, the filter rail under it, the side
       panel with drives and largest items, the map (or the start screen, the Insights view, the Changes view, the
       scan card), and the status bar. The text is set in Build() from the same Strings.resx. -->

  <Grid>
  <DockPanel>
    <!-- ============================================================ top bar -->
    <Border x:Name="TopBar" DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="10,8" SizeChanged="TopBar_SizeChanged">
      <DockPanel>
        <!-- when the two groups do not fit side by side, FitToolbar drops the labels, then the view buttons' text, then the palette's name -->
        <StackPanel x:Name="ToolbarRight" DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="ColorLabel" Classes="dim" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="ColorCombo" Width="130" SelectionChanged="ColorMode_Changed" />
          <TextBlock x:Name="PaletteLabel" Classes="dim" VerticalAlignment="Center" Margin="14,0,8,0" />
          <Button x:Name="PaletteButton" Classes="combo" Width="250" />
          <Border Classes="divider" />
          <Button x:Name="SettingsButton" Classes="tool" Margin="0,0,6,0" Click="Settings_Click"><controls:Icon Glyph="{StaticResource Icon.Settings}" Width="15" Height="15" /></Button>
          <Button x:Name="ThemeButton" Classes="tool" Margin="0,0,6,0" Click="Theme_Click"><controls:Icon x:Name="ThemeIcon" Glyph="{StaticResource Icon.Moon}" Width="15" Height="15" /></Button>
          <Button x:Name="AboutButton" Classes="tool" Click="About_Click"><controls:Icon Glyph="{StaticResource Icon.Info}" Width="15" Height="15" /></Button>
        </StackPanel>

        <StackPanel x:Name="ToolbarLeft" Orientation="Horizontal" ClipToBounds="True">
          <Button x:Name="ScanFolderButton" Classes="primary" Click="ScanFolder_Click" />
          <Button x:Name="RescanButton" Classes="tool" Margin="6,0,6,0" Click="Rescan_Click"><controls:Icon Glyph="{StaticResource Icon.Refresh}" Width="15" Height="15" /></Button>
          <Button x:Name="CloseScanButton" Classes="tool" Margin="0,0,6,0" Click="CloseScan_Click"><controls:Icon Glyph="{StaticResource Icon.Close}" Width="15" Height="15" /></Button>
          <Border Classes="divider" />
          <Button x:Name="UpButton" Classes="tool" Margin="0,0,6,0" Click="Up_Click"><controls:Icon Glyph="{StaticResource Icon.Up}" Width="15" Height="15" /></Button>
          <Button x:Name="HomeButton" Classes="tool" Margin="0,0,6,0" Click="Fit_Click"><controls:Icon Glyph="{StaticResource Icon.Home}" Width="15" Height="15" /></Button>
          <Button x:Name="PanelButton" Classes="tool" Margin="0,0,6,0" Click="Panel_Click"><controls:Icon Glyph="{StaticResource Icon.SidePanel}" Width="15" Height="15" /></Button>
          <Border Classes="divider" />
          <Button x:Name="MapViewButton" Classes="primary" Margin="0,0,2,0" Padding="10,0" Click="MapView_Click" />
          <Button x:Name="InsightsButton" Classes="tool" Margin="0,0,2,0" Padding="10,0" Click="InsightsView_Click" />
          <Button x:Name="ChangesButton" Classes="tool" Margin="0,0,6,0" Padding="10,0" Click="ChangesView_Click" />
          <Border Classes="divider" />
          <Button x:Name="ZoomOutButton" Classes="tool" Margin="0,0,6,0" Click="ZoomOut_Click"><controls:Icon Glyph="{StaticResource Icon.ZoomOut}" Width="15" Height="15" /></Button>
          <TextBlock x:Name="ZoomLabel" Width="64" TextAlignment="Center" VerticalAlignment="Center" Classes="dim" Text="—" Margin="0,0,6,0" />
          <Button x:Name="ZoomInButton" Classes="tool" Margin="0,0,6,0" Click="ZoomIn_Click"><controls:Icon Glyph="{StaticResource Icon.ZoomIn}" Width="15" Height="15" /></Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================================================ protected folders notice -->
    <Border x:Name="AccessBar" DockPanel.Dock="Top" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="4,0,0,1" Padding="12,6">
      <DockPanel>
        <Button x:Name="AccessCloseButton" DockPanel.Dock="Right" Classes="tool" Height="28" Click="CloseAccessBar_Click"><controls:Icon Glyph="{StaticResource Icon.Close}" Width="15" Height="15" /></Button>
        <Button x:Name="AccessRestartButton" DockPanel.Dock="Right" Classes="primary" Height="28" Margin="12,0,6,0" Click="RestartElevated_Click" />
        <TextBlock x:Name="AccessText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ============================================================ path row -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Window}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="6,4" MinHeight="36">
      <DockPanel>
        <!-- The filter text lives here, hidden: shortcuts, presets and both filter faces all write to it. -->
        <TextBox x:Name="FilterBox" IsVisible="False" Width="0" TextChanged="FilterBox_TextChanged" />
        <Button x:Name="FilterToggleButton" DockPanel.Dock="Right" Classes="tool" Height="28" Margin="12,0,4,0" Click="FilterToggle_Click" />
        <TextBlock x:Name="BreadcrumbInfo" DockPanel.Dock="Right" Classes="dim" VerticalAlignment="Center" Margin="12,0,4,0" />
        <StackPanel x:Name="Crumbs" Orientation="Horizontal" ClipToBounds="True" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- ============================================================ filter rail (Settings › Map › Filter layout: Rail) -->
    <Border DockPanel.Dock="Top" x:Name="FilterRail" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="12,7">
      <DockPanel x:Name="RailContent" LastChildFill="False" />
    </Border>

    <!-- ============================================================ status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <StackPanel x:Name="StatusMeters" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
        <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ============================================================ side panel -->
    <Border x:Name="SidePanel" DockPanel.Dock="Left" Width="300" MinWidth="220" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock x:Name="DrivesTitle" Grid.Row="0" FontSize="15" FontWeight="SemiBold" Margin="14,12,14,4" />
        <TextBlock x:Name="DrivesHint" Grid.Row="1" Classes="dim" FontSize="12" Margin="14,0,14,4" />
        <ScrollViewer x:Name="DriveScroller" Grid.Row="2" MaxHeight="320" MinHeight="72">
          <StackPanel x:Name="DriveList" Margin="8,0" Spacing="1" />
        </ScrollViewer>
        <!-- the line between Drives and Largest items doubles as the handle that sets the drive list's height -->
        <Border x:Name="DriveResizeHandle" Grid.Row="3" Height="9" Margin="14,4,14,0" Background="Transparent" Cursor="SizeNorthSouth">
          <Border Height="1" VerticalAlignment="Center" Background="{DynamicResource Stroke}" />
        </Border>
        <TextBlock x:Name="ListsTitle" Grid.Row="4" FontSize="15" FontWeight="SemiBold" Margin="14,4,14,2" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="14,4,14,6">
          <Button x:Name="ListFilesButton" Classes="segment" Height="30" Click="ListKind_Click" Tag="Files" />
          <Button x:Name="ListFoldersButton" Classes="segment" Height="30" Click="ListKind_Click" Tag="Folders" />
          <Button x:Name="ListTypesButton" Classes="segment" Height="30" Click="ListKind_Click" Tag="Types" />
          <Button x:Name="ListChangesButton" Classes="segment" Height="30" Click="ListKind_Click" Tag="Changes" IsVisible="False" />
        </StackPanel>
        <TextBlock x:Name="ListHint" Grid.Row="6" Classes="dim" FontSize="12" Margin="14,0,14,6" TextTrimming="CharacterEllipsis" />
        <ScrollViewer Grid.Row="7">
          <StackPanel x:Name="TopList" Margin="8,0,8,8" Spacing="1" />
        </ScrollViewer>
        <!-- the panel's edge: drag to set its width -->
        <Border x:Name="PanelResizeHandle" Grid.Row="0" Grid.RowSpan="8" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" />
      </Grid>
    </Border>

    <!-- ============================================================ map -->
    <Grid x:Name="MapHost" Background="{DynamicResource Window}">
      <controls:TreemapControl x:Name="Treemap" MapBackground="{DynamicResource MapBackground}" />

      <!-- the Insights view, in the map's place -->
      <ScrollViewer x:Name="InsightsView" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Window}" SizeChanged="InsightsView_SizeChanged">
        <StackPanel x:Name="InsightsHost" Margin="18,16,22,18" />
      </ScrollViewer>

      <!-- the Changes view, in the map's place: built by BuildChangesView -->
      <Grid x:Name="ChangesView" IsVisible="False" Background="{DynamicResource Window}" />

      <!-- start screen: pick a drive, or pick up where you left off -->
      <Grid x:Name="EmptyHint">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" MaxWidth="900" Margin="40,32">
            <!-- the header: the mark, the title and hint, the totals of the scanned drives on the right -->
            <DockPanel Margin="4,0">
              <StackPanel x:Name="EmptyTotalsPanel" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="24,0,0,0">
                <TextBlock x:Name="EmptyTotalsUsed" FontSize="18" FontWeight="SemiBold" TextAlignment="Right" />
                <TextBlock x:Name="EmptyTotals" Classes="dim" FontSize="12.5" TextAlignment="Right" Margin="0,2,0,0" />
              </StackPanel>
              <Image DockPanel.Dock="Left" Source="avares://SpaceSharp/Assets/SpaceSharp-256.png" Width="52" Height="52" Margin="0,0,16,0" VerticalAlignment="Center" />
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="EmptyTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="EmptyText" Classes="dim" FontSize="13.5" Margin="0,4,0,0" TextWrapping="Wrap" />
              </StackPanel>
            </DockPanel>
            <!-- the last scan as a panel, the earlier ones as a list; built by BuildRecentScans -->
            <StackPanel x:Name="RecentHost" Margin="0,22,0,0" Spacing="12" />
            <!-- the two actions, with the fast-scan line on the right -->
            <DockPanel Margin="0,16,0,0">
              <TextBlock x:Name="EmptyFastLine" DockPanel.Dock="Right" Classes="dim" FontSize="12.5" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap" />
              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button x:Name="EmptyScanButton" Classes="action" Click="ScanFolder_Click">
                  <StackPanel x:Name="EmptyScanContent" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="EmptyOpenButton" Classes="action" Click="OpenScan_Click">
                  <StackPanel x:Name="EmptyOpenContent" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" />
                </Button>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- the hover tooltip: placed beside the pointer by code. It lives on a canvas so its position never takes part
           in the map's layout: a canvas asks nothing of its parent and measures its child without a constraint, so a
           card near the right edge cannot change the map's size or its own width and flicker between two places. -->
      <Canvas x:Name="TipLayer" IsHitTestVisible="False" ClipToBounds="True">
        <Border x:Name="HoverTip" IsVisible="False" IsHitTestVisible="False"
                Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="12,8"
                MinWidth="200" MaxWidth="360" BoxShadow="0 3 14 0 #73000000">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="TipSize" DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
              <TextBlock x:Name="TipName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel x:Name="TipLines" Margin="0,2,0,0" />
          </StackPanel>
        </Border>
      </Canvas>

      <!-- the filter drawer (the default filter layout): a sheet over the right of the map -->
      <Border x:Name="FilterDrawer" HorizontalAlignment="Right" Width="380" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0" BoxShadow="0 0 24 0 #80000000">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="16,0" Height="44">
            <DockPanel>
              <Button x:Name="DrawerCloseButton" DockPanel.Dock="Right" Classes="tool" Height="28" MinWidth="28" Padding="4,0" Click="CloseDrawer_Click"><controls:Icon Glyph="{StaticResource Icon.Close}" Width="15" Height="15" /></Button>
              <Button x:Name="DrawerClearButton" DockPanel.Dock="Right" Classes="tool" Height="28" IsEnabled="False" Click="ClearFilter_Click" />
              <TextBlock x:Name="DrawerTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource Window}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel x:Name="DrawerFooter" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DrawerContent" Margin="16,12,16,8" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- while scanning: a card in the map's corner; the last map stays in view behind it (centered when there is none) -->
      <Grid x:Name="ScanCard" IsVisible="False" Background="Transparent">
        <!-- over the map during a file-table scan: says why there is no live drawing -->
        <Border x:Name="SampleBanner" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="18,18,18,0" MaxWidth="720"
                Padding="16,11" CornerRadius="8" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" BoxShadow="0 8 28 0 #80000000">
          <DockPanel>
            <controls:Icon DockPanel.Dock="Left" Glyph="{StaticResource Icon.Info}" Width="18" Height="18" StrokeWidth="2.2" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,1,12,0" />
            <TextBlock FontSize="13.5" TextWrapping="Wrap" LineHeight="19"><Run x:Name="SampleTitle" FontWeight="Bold" /><Run Text="  " /><Run x:Name="SampleText" Foreground="{DynamicResource TextDim}" /></TextBlock>
          </DockPanel>
        </Border>
        <Border x:Name="ScanPanel" Width="372" Padding="18,16,18,14" CornerRadius="12" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="18" BoxShadow="0 12 40 0 #99000000">
          <StackPanel Spacing="12">
            <!-- title row: spinner, drive, what is in use, percent, Cancel -->
            <DockPanel>
              <Button x:Name="CancelButton" DockPanel.Dock="Right" Classes="tool" Width="28" Height="28" MinWidth="28" Padding="0" Margin="8,0,0,0" Click="Cancel_Click">
                <controls:Icon Glyph="{StaticResource Icon.Close}" Width="13" Height="13" />
              </Button>
              <TextBlock x:Name="ScanPercent" DockPanel.Dock="Right" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="8,0,0,0" />
              <controls:Icon x:Name="ScanSpinner" DockPanel.Dock="Left" Glyph="{StaticResource Icon.Loader}" Width="16" Height="16" StrokeWidth="2.4" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run x:Name="ScanTitle" FontSize="15" FontWeight="Bold" /><Run Text="  " /><Run x:Name="ScanSubtitle" FontSize="12.5" Foreground="{DynamicResource TextDim}" /></TextBlock>
            </DockPanel>

            <!-- one thin bar, a segment per stage -->
            <Grid ColumnDefinitions="1.3*,2,2.2*,2,*" Height="4">
              <Grid x:Name="StageFindBar" Grid.Column="0" ClipToBounds="True">
                <Border Background="{DynamicResource Control}" CornerRadius="2" />
                <Border x:Name="StageFindFill" Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="4" />
              </Grid>
              <Grid x:Name="StageBuildBar" Grid.Column="2" ClipToBounds="True">
                <Border Background="{DynamicResource Control}" CornerRadius="2" />
                <Border x:Name="StageBuildFill" Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
              </Grid>
              <Grid x:Name="StageDrawBar" Grid.Column="4" ClipToBounds="True">
                <Border Background="{DynamicResource Control}" CornerRadius="2" />
                <Border x:Name="StageDrawFill" Background="{DynamicResource Accent}" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
              </Grid>
            </Grid>

            <!-- the three stages as a list; a stage's detail wraps under its name rather than being cut -->
            <StackPanel Spacing="6">
              <DockPanel>
                <controls:Icon x:Name="StageFindIcon" DockPanel.Dock="Left" Glyph="{StaticResource Icon.Loader}" Width="13" Height="13" StrokeWidth="2.6" Foreground="{DynamicResource Accent}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="17"><Run x:Name="StageFindText" FontWeight="SemiBold" /><Run Text=" " /><Run x:Name="StageFindDetail" Foreground="{DynamicResource TextDim}" /></TextBlock>
              </DockPanel>
              <DockPanel>
                <controls:Icon x:Name="StageBuildIcon" DockPanel.Dock="Left" Glyph="{StaticResource Icon.Circle}" Width="13" Height="13" StrokeWidth="2.6" Foreground="{DynamicResource TextDim}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <TextBlock FontSize="12.5" TextWrapping="Wrap" LineHeight="17"><Run x:Name="StageBuildText" FontWeight="SemiBold" /><Run Text=" " /><Run x:Name="StageBuildDetail" Foreground="{DynamicResource TextDim}" /></TextBlock>
              </DockPanel>
              <DockPanel>
                <controls:Icon x:Name="StageDrawIcon" DockPanel.Dock="Left" Glyph="{StaticResource Icon.Circle}" Width="13" Height="13" StrokeWidth="2.6" Foreground="{DynamicResource TextDim}" VerticalAlignment="Top" Margin="0,2,8,0" />
                <TextBlock x:Name="StageDrawText" FontSize="12.5" FontWeight="SemiBold" Classes="dim" TextWrapping="Wrap" LineHeight="17" />
              </DockPanel>
            </StackPanel>

            <!-- the numbers, under a rule -->
            <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
              <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="14">
                  <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ScanSize" Text="0 B" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ScanSizeLabel" Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="1">
                    <TextBlock x:Name="ScanRate" Text="0" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="ScanRateLabel" Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" MinWidth="52">
                    <TextBlock x:Name="ScanElapsed" Text="0:00" FontSize="17" FontWeight="Bold" />
                    <TextBlock x:Name="ScanElapsedLabel" Classes="dim" FontSize="11.5" />
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ScanPath" Classes="dim" FontSize="11" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
  <!-- the dim behind Settings, Inspect, About and the update prompt; its opacity is Settings › Appearance › Dim behind windows -->
  <Border x:Name="DimOverlay" Background="Black" Opacity="0" IsVisible="False" IsHitTestVisible="False" />
  </Grid>
</Window>
