<Window x:Class="SpaceSharp.PaletteEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpaceSharp.Util"
        xmlns:controls="clr-namespace:SpaceSharp.Controls"
        Title="{u:T PaletteEd_Title}"
        Width="1180" Height="780" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <DockPanel>
        <!-- footer: the checks on the left, the ways out on the right -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="{u:T PaletteEd_Export}" Tag="{StaticResource Icon.Copy}" Click="Export_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="{u:T PaletteEd_Cancel}" IsCancel="True" Margin="6,0,0,0" />
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Content="{u:T PaletteEd_Save}" IsDefault="True" Margin="6,0,0,0" Click="Save_Click" />
                </StackPanel>
                <TextBlock x:Name="Checks" VerticalAlignment="Center" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- the editor -->
            <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel x:Name="Editor" Margin="22,18,22,18" />
                </ScrollViewer>
            </Border>

            <!-- the preview: the sample drive in the palette being made, in any color mode -->
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="16,9">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{u:T PaletteEd_PreviewNote}" Foreground="{DynamicResource TextDim}" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{u:T PaletteEd_Preview}" Foreground="{DynamicResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button x:Name="ModeDepth" Style="{StaticResource TabButton}" Content="{u:T Main_Depth}" Click="Mode_Click" />
                            <Button x:Name="ModeBranch" Style="{StaticResource TabButton}" Content="{u:T Main_TopFolder}" Click="Mode_Click" />
                            <Button x:Name="ModeType" Style="{StaticResource TabButton}" Content="{u:T Main_FileType}" Click="Mode_Click" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Margin="14" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Stroke}" ClipToBounds="True">
                    <controls:TreemapControl x:Name="Preview" IsHitTestVisible="False" Focusable="False" />
                </Border>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
