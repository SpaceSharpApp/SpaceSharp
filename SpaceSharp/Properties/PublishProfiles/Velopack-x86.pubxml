<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish for the 32-bit "vpk pack" (channel win-x86): the x86 installer, portable zip and update packages.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <DebugType>none</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\velopack-x86\</PublishDir>
  </PropertyGroup>
</Project>
