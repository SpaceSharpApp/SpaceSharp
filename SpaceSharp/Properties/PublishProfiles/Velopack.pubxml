<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish used as input for "vpk pack" (Velopack needs a folder, not a single-file exe).
  Produces the installer, the auto-updating portable zip and the update packages.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <!-- Embedded symbols: crash logs get file and line numbers, for a few hundred KB more in the exe. -->
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\velopack\</PublishDir>
  </PropertyGroup>
</Project>
