<?xml version="1.0" encoding="utf-8"?>
<!--
  A small SpaceSharp.exe that uses the .NET 10 runtime installed on the PC.
  If the runtime is missing, Windows shows a prompt with a download link.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Embedded symbols: crash logs get file and line numbers, for a few hundred KB more in the exe. -->
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\small\</PublishDir>
  </PropertyGroup>
</Project>
