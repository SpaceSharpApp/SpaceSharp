<?xml version="1.0" encoding="utf-8"?>
<!--
  One SpaceSharp.exe that runs on any 64-bit Windows 10/11 PC, no .NET install needed.
  Bigger file (the .NET runtime is packed inside, compressed).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- Embedded symbols: crash logs get file and line numbers, for a few hundred KB more in the exe. -->
    <DebugType>embedded</DebugType>
    <PublishDir>$(MSBuildProjectDirectory)\..\publish\portable\</PublishDir>
  </PropertyGroup>
</Project>
