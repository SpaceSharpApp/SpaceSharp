<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="SpaceSharp.InspectWindow"
        Width="1000" Height="1120" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="avares://SpaceSharp/Assets/SpaceSharp.ico"
        Background="{DynamicResource Window}">

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="16,12">
      <DockPanel>
        <Button x:Name="CloseButton" DockPanel.Dock="Right" Classes="primary" MinWidth="84" HorizontalContentAlignment="Center" IsDefault="True" IsCancel="True" Click="Close_Click" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Spacing="6">
          <Button x:Name="CopyButton" Classes="tool" Click="Copy_Click" />
          <Button x:Name="RevealButton" Classes="tool" Click="Reveal_Click" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto">
      <!-- the same margin on every side, so the last table never sits on the footer -->
      <StackPanel x:Name="Body" Margin="24,14,24,24" Spacing="14">
        <!-- ================================================================ header: crumbs, then the name left and the size right -->
        <StackPanel x:Name="Header" SizeChanged="Header_SizeChanged" Spacing="8">
          <!-- one line: the middle of a long path folds into a … button whose flyout lists the folded folders -->
          <StackPanel x:Name="Crumbs" Orientation="Horizontal" Margin="-6,0,0,0" />
          <Grid ColumnDefinitions="*,16,Auto">
            <DockPanel VerticalAlignment="Center">
              <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontSize="18" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,10,0" />
              <!-- a file's own icon, as Windows shows it, in place of the glyph -->
              <Image x:Name="IconImage" DockPanel.Dock="Left" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0" IsVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality" />
              <TextBlock x:Name="NameText" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
              <TextBlock x:Name="SizeText" FontSize="30" FontWeight="Bold" VerticalAlignment="Center" />
              <TextBlock x:Name="OnDiskText" Classes="dim" FontSize="12.5" VerticalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>

        <!-- ================================================================ the story: one line per fact, with an icon each -->
        <Border x:Name="Card" Classes="card flat" CornerRadius="10" Padding="16,2">
          <StackPanel x:Name="Sentences" />
        </Border>

        <!-- ================================================================ the tables -->
        <Panel x:Name="WhereHost" />
        <Grid x:Name="Pair" ColumnDefinitions="*,14,*">
          <Panel x:Name="TypeHost" VerticalAlignment="Top" />
          <StackPanel x:Name="RightColumn" Grid.Column="2" Spacing="14">
            <Panel x:Name="AgeHost" />
            <Panel x:Name="FilesHost" />
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
