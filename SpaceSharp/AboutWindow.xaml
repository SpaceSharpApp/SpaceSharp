<Window x:Class="SpaceSharp.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpaceSharp.Util"
        Title="{u:T About_AboutSpaceSharp}"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{u:T About_Close}"
                        IsDefault="True" IsCancel="True" Click="Close_Click" />
                <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Copy}" Content="{u:T About_CopyVersionInfo}"
                        HorizontalAlignment="Left" Click="CopyInfo_Click" />
            </DockPanel>
        </Border>

        <StackPanel Margin="24,26,24,18">
            <DockPanel>
                <Image Source="/Assets/SpaceSharp-256.png" Width="64" Height="64" Margin="0,0,18,0"
                       VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="SpaceSharp" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock x:Name="TaglineText" Foreground="{DynamicResource TextDim}" Margin="0,5,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- the list: one row per thing About can do; rows are built in code so the icon, title and sub-line stay aligned -->
            <Border Margin="0,20,0,0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True">
                <StackPanel x:Name="Rows" />
            </Border>

            <TextBlock x:Name="CopyrightText" Foreground="{DynamicResource TextDim}" FontSize="11.5" Margin="0,14,0,0" />
        </StackPanel>
    </DockPanel>
</Window>
