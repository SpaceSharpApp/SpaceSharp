<Window x:Class="SpaceSharp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpaceSharp.Util"
        xmlns:controls="clr-namespace:SpaceSharp.Controls"
        Title="SpaceSharp"
        Width="1400" Height="880" MinWidth="1040" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown">

    <DockPanel>
        <!-- ============================================================ top bar -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="{u:T Main_ColorBy}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <ComboBox x:Name="ColorCombo" Width="120" SelectionChanged="ColorSettings_Changed">
                        <ComboBoxItem Content="{u:T Main_TopFolder}" />
                        <ComboBoxItem Content="{u:T Main_Depth}" />
                        <ComboBoxItem Content="{u:T Main_FileType}" />
                        <ComboBoxItem Content="{u:T Main_Change}" />
                    </ComboBox>
                    <TextBlock Text="{u:T Main_Palette}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"
                               Margin="14,0,8,0" />
                    <!-- Pixel scrolling: with groups, the default item-wise scrolling snaps the list by a whole
                         item or group whenever the mouse enters a partly visible row. -->
                    <ComboBox x:Name="PaletteCombo" Width="250" MaxDropDownHeight="640"
                              ScrollViewer.CanContentScroll="False"
                              SelectionChanged="ColorSettings_Changed">
                        <ComboBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Margin="8,8,8,3"
                                                   Foreground="{DynamicResource TextDim}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ComboBox.GroupStyle>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl ItemsSource="{Binding Swatches}" VerticalAlignment="Center">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="9" Height="14" Margin="0,0,1,0" CornerRadius="2"
                                                        Background="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Name}" Margin="9,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Style="{StaticResource ToolDivider}" />
                    <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Settings}" Margin="0,0,6,0"
                            ToolTip="{u:T Main_SettingsCtrl}" Click="SettingsButton_Click" />
                    <Button x:Name="ThemeButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0" Tag="{StaticResource Icon.Moon}"
                            ToolTip="{u:T Main_Theme}" Click="ThemeButton_Click" />
                    <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Info}" ToolTip="{u:T Main_AboutSpaceSharpF1}"
                            Click="About_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="ScanFolderButton" Style="{StaticResource AccentButton}"
                            Tag="{StaticResource Icon.ScanFolder}" Content="{u:T Main_ScanFolder}" Click="ScanFolder_Click" />
                    <Button x:Name="RescanButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            Tag="{StaticResource Icon.Refresh}" ToolTip="{u:T Main_RescanF5}" Click="Rescan_Click" />

                    <Border Style="{StaticResource ToolDivider}" />

                    <Button x:Name="UpButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            Tag="{StaticResource Icon.Up}" ToolTip="{u:T Main_UpOneFolderBackspace}" Click="Up_Click" />
                    <Button x:Name="FitButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            Tag="{StaticResource Icon.Home}" ToolTip="{u:T Main_ShowWholeMapHome}" Click="Fit_Click" />
                    <Button x:Name="ListsButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            Tag="{StaticResource Icon.SidePanel}" ToolTip="{u:T Main_DrivesAndLargestItems}" Click="Lists_Click" />

                    <Border Style="{StaticResource ToolDivider}" />

                    <!-- the two views of the scan: the map, or the insights that replace it -->
                    <Button x:Name="MapViewButton" Style="{StaticResource AccentButton}" Margin="0,0,2,0" Padding="10,0"
                            Tag="{StaticResource Icon.Treemap}" Content="{u:T Main_ViewMap}" ToolTip="{u:T Main_ViewMapTip}" Click="MapView_Click" />
                    <Button x:Name="InsightsButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0" Padding="10,0"
                            Tag="{StaticResource Icon.Info}" Content="{u:T Main_ViewInsights}" ToolTip="{u:T Main_ViewInsightsTip}" Click="InsightsView_Click" />

                    <Border Style="{StaticResource ToolDivider}" />

                    <Button x:Name="ZoomOutButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            Tag="{StaticResource Icon.ZoomOut}" ToolTip="{u:T Main_ZoomOutMouseWheel}" Click="ZoomOut_Click" />
                    <TextBlock x:Name="ZoomLabel" Width="64" TextAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextDim}" Text="—" Margin="0,0,6,0" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}" Margin="0,0,6,0"
                            Tag="{StaticResource Icon.ZoomIn}" ToolTip="{u:T Main_ZoomInMouseWheel}" Click="ZoomIn_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============================================================ protected folders notice -->
        <Border x:Name="AccessBar" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Accent}" BorderThickness="4,0,0,1" Padding="12,6">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Close}" Height="28"
                        ToolTip="{u:T Main_Dismiss}" Click="CloseAccessBar_Click" />
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="28" Margin="12,0,6,0"
                        Tag="{StaticResource Icon.Shield}" Content="{u:T Main_RestartAsAdministrator}" Click="RestartElevated_Click" />
                <TextBlock x:Name="AccessText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>


        <!-- ============================================================ breadcrumb -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,0,0,1" Padding="6,4" MinHeight="36">
            <DockPanel>
                <!-- The filter text lives here, hidden: shortcuts, presets and the panels all write to it. -->
                <TextBox x:Name="FilterBox" Visibility="Collapsed" Width="0" TextChanged="FilterBox_TextChanged" />
                <Button x:Name="FilterToggleButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Height="28"
                        Tag="{StaticResource Icon.Filter}" Content="{u:T Main_Filter}" Margin="12,0,4,0" ToolTip="{u:T Filter_ToggleTip}" Click="FilterToggle_Click" />
                <WrapPanel x:Name="LegendPanel" DockPanel.Dock="Right" Visibility="Collapsed"
                           VerticalAlignment="Center" Margin="12,0,4,0" />
                <TextBlock x:Name="BreadcrumbInfo" DockPanel.Dock="Right" Foreground="{DynamicResource TextDim}"
                           VerticalAlignment="Center" Margin="12,0,4,0" />
                <StackPanel x:Name="BreadcrumbPanel" Orientation="Horizontal" ClipToBounds="True"
                            VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- ============================================================ filter rail (the default filter face) -->
        <Border x:Name="FilterRail" DockPanel.Dock="Top" Visibility="Collapsed" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="12,7">
            <DockPanel x:Name="RailContent" LastChildFill="False" />
        </Border>

        <!-- ============================================================ status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <TextBlock x:Name="StatusScan" DockPanel.Dock="Right" Foreground="{DynamicResource TextDim}"
                           Margin="16,0,0,0" />
                <TextBlock x:Name="StatusHover" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- ============================================================ side panel: top lists -->
        <Border x:Name="SidePanel" DockPanel.Dock="Left" Width="300" MinWidth="220"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
          <Grid>
            <DockPanel>
                <!-- drives -->
                <TextBlock DockPanel.Dock="Top" Text="{u:T Main_Drives}" FontSize="15" FontWeight="SemiBold" Margin="14,12,14,4" />
                <TextBlock DockPanel.Dock="Top" Text="{u:T Main_ClickADriveTo}" Foreground="{DynamicResource TextDim}"
                           FontSize="12" Margin="14,0,14,4" />
                <ListBox x:Name="DriveList" DockPanel.Dock="Top" MaxHeight="320" MinHeight="72" SelectionChanged="DriveList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <controls:Icon Glyph="{Binding Icon}" Width="16" Height="16"
                                        Foreground="{DynamicResource TextDim}" Margin="0,1,10,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding FreeText}" Foreground="{DynamicResource TextDim}"
                                           Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Height="6" Margin="0,7,0,5">
                                    <Border Background="{DynamicResource Control}" CornerRadius="3" />
                                    <Border HorizontalAlignment="Left" Width="{Binding BarWidth}" CornerRadius="3"
                                            Background="{DynamicResource Accent}" Opacity="0.9" />
                                </Grid>
                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Detail}"
                                           Foreground="{DynamicResource TextDim}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <!-- drag to give the drives or the list more room -->
                <Thumb x:Name="SectionSplitter" DockPanel.Dock="Top" Style="{StaticResource SplitterThumb}" Height="9" Margin="0,4,0,2" Cursor="SizeNS"
                       DragDelta="SectionSplitter_DragDelta" DragCompleted="Splitter_DragCompleted" />

                <!-- largest items (hidden while the Insights view shows them in full) -->
                <DockPanel x:Name="LargestSection">
                <TextBlock DockPanel.Dock="Top" Text="{u:T Main_LargestItems}" FontSize="15" FontWeight="SemiBold" Margin="14,4,14,2" />
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,10,4">
                    <Button x:Name="TabFiles" Style="{StaticResource TabButton}" Content="{u:T Main_Files}" Click="Tab_Click" />
                    <Button x:Name="TabFolders" Style="{StaticResource TabButton}" Content="{u:T Main_Folders}" Click="Tab_Click" />
                    <Button x:Name="TabTypes" Style="{StaticResource TabButton}" Content="{u:T Main_Types}" Click="Tab_Click" />
                    <Button x:Name="TabChanges" Style="{StaticResource TabButton}" Content="{u:T Main_Changes}" Click="Tab_Click" Visibility="Collapsed" />
                </StackPanel>
                <TextBlock x:Name="ListHint" DockPanel.Dock="Top" Foreground="{DynamicResource TextDim}" FontSize="12"
                           Margin="14,0,14,6" TextTrimming="CharacterEllipsis" />
                <ListBox x:Name="TopList" SelectionChanged="TopList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.ColumnSpan="3" HorizontalAlignment="Left" Width="{Binding BarWidth}" Height="3"
                                        VerticalAlignment="Bottom" Margin="0,0,0,-4" CornerRadius="2"
                                        Background="{DynamicResource Accent}" Opacity="0.55" />
                                <Border Width="10" Height="10" CornerRadius="3" Margin="0,0,8,0" VerticalAlignment="Center"
                                        Background="{Binding Swatch}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="11"
                                               Foreground="{DynamicResource TextDim}" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding SizeText}" Margin="10,0,0,0"
                                           VerticalAlignment="Center" FontWeight="SemiBold" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </DockPanel>
            </DockPanel>
            <!-- drag to resize the whole panel -->
            <Thumb x:Name="PanelSplitter" Style="{StaticResource SplitterThumb}" HorizontalAlignment="Right" Width="6" Cursor="SizeWE"
                   DragDelta="PanelSplitter_DragDelta" DragCompleted="Splitter_DragCompleted" />
          </Grid>
        </Border>

        <!-- ============================================================ map -->
        <Grid Background="{DynamicResource Bg}">
            <controls:TreemapControl x:Name="Treemap" MapBackground="{DynamicResource MapBg}">
                <controls:TreemapControl.ContextMenu>
                    <ContextMenu Opened="TreemapMenu_Opened">
                        <MenuItem x:Name="MenuInspect" Style="{StaticResource PrimaryMenuItem}" InputGestureText="{u:T Main_CtrlI}" Click="MenuInspect_Click">
                            <MenuItem.Header>
                                <StackPanel>
                                    <TextBlock x:Name="MenuInspectTitle" Text="{u:T Main_Inspect}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MenuInspectSub" FontSize="11.5" Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                </StackPanel>
                            </MenuItem.Header>
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Info}" Width="16" Height="16" Foreground="{DynamicResource Accent}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuFocus" Header="{u:T Main_ZoomToFolder}" InputGestureText="{u:T Main_DoubleClick}" Click="MenuFocus_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.ZoomIn}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuUp" Header="{u:T Main_UpOneFolder}" InputGestureText="{u:T Main_Backspace}" Click="Up_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Up}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuFit" Header="{u:T Main_ShowWholeMap}" InputGestureText="{u:T Main_Home}" Click="Fit_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Home}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuOpen" Header="{u:T Main_Open}" InputGestureText="{u:T Main_Enter}" Click="MenuOpen_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Open}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuExplorer" Header="{u:T Main_ShowInExplorer}" Click="MenuExplorer_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.ScanFolder}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuProperties" Header="{u:T Main_Properties}" InputGestureText="{u:T Main_AltEnter}" Click="MenuProperties_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Properties}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuCopy" Header="{u:T Main_CopyPath}" InputGestureText="{u:T Main_CtrlC}" Click="MenuCopy_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Copy}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuCopyName" Header="{u:T Main_CopyName}" Click="MenuCopyName_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Copy}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuFilterType" Header="{u:T Main_ShowOnlyThisFile}" Click="MenuFilterType_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Filter}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="MenuSelectFolder" Header="{u:T Main_SelectEverythingInThis}" Click="MenuSelectFolder_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Selection}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem x:Name="MenuRescan" Header="{u:T Main_RescanThisFolder}" Click="MenuRescan_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Refresh}" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{u:T Main_ScanFile}">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Open}" />
                            </MenuItem.Icon>
                            <MenuItem x:Name="MenuSaveScan" Header="{u:T Main_SaveScanAs}" InputGestureText="{u:T Main_CtrlS}" Click="MenuSaveScan_Click" />
                            <MenuItem Header="{u:T Main_OpenSavedScan}" InputGestureText="{u:T Main_CtrlO}" Click="MenuOpenScan_Click" />
                            <MenuItem x:Name="MenuCompareScan" Header="{u:T Main_CompareWithASaved}" Click="MenuCompareScan_Click" />
                            <MenuItem x:Name="MenuClearCompare" Header="{u:T Main_StopComparing}" Click="MenuClearCompare_Click" />
                        </MenuItem>
                        <MenuItem x:Name="MenuExport" Header="{u:T Main_ExportToCSV}">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Export}" />
                            </MenuItem.Icon>
                            <MenuItem Header="{u:T Main_LargestFiles}" Click="MenuExportFiles_Click" />
                            <MenuItem x:Name="MenuExportFolder" Header="{u:T Main_ThisFolder}" Click="MenuExportFolder_Click" />
                            <MenuItem x:Name="MenuExportMatches" Header="{u:T Main_FilterMatches}" Click="MenuExportMatches_Click" />
                            <MenuItem x:Name="MenuExportChanges" Header="{u:T Main_ChangesSinceLastScan}" Click="MenuExportChanges_Click" />
                        </MenuItem>
                        <MenuItem x:Name="MenuDelete" Header="{u:T Main_MoveToRecycleBin}" InputGestureText="{u:T Main_Del}"
                                  Style="{StaticResource DangerMenuItem}" Click="MenuDelete_Click">
                            <MenuItem.Icon>
                                <controls:Icon Style="{StaticResource MenuIcon}" Glyph="{StaticResource Icon.Delete}" Foreground="{DynamicResource Danger}" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </controls:TreemapControl.ContextMenu>
            </controls:TreemapControl>

            <!-- insights: the scan summed up, in the map's place while the Insights view is on -->
            <ScrollViewer x:Name="InsightsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="InsightsView_SizeChanged"
                          Background="{DynamicResource Bg}" Focusable="False">
                <StackPanel x:Name="InsightsHost" Margin="18,16,22,18" />
            </ScrollViewer>

            <!-- start screen: pick a drive, or pick up where you left off (recent saved scans); the administrator offer is one footer line -->
            <Grid x:Name="EmptyHint">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="520">
                    <DockPanel>
                        <Image Source="/Assets/SpaceSharp-256.png" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="EmptyTitle" Text="{u:T Start_PickADrive}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="EmptySubtitle" Text="{u:T Start_RecentHint}" Foreground="{DynamicResource TextDim}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <Border x:Name="RecentCard" Margin="0,18,0,0" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                            BorderThickness="1" CornerRadius="10" SnapsToDevicePixels="True" Visibility="Collapsed">
                        <StackPanel x:Name="RecentRows" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.ScanFolder}" Content="{u:T Start_ScanAFolder}" Click="ScanFolder_Click" />
                        <Button Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Open}" Content="{u:T Start_OpenASavedScan}" Margin="8,0,0,0" Click="MenuOpenScan_Click" />
                    </StackPanel>
                </StackPanel>

            </Grid>

            <!-- the filter drawer (Settings › Map › Filter layout): a sheet over the right of the map -->
            <Border x:Name="FilterDrawer" HorizontalAlignment="Right" Width="380" Visibility="Collapsed"
                    Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.5" Color="Black" />
                </Border.Effect>
                <DockPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="16,0" Height="44">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Close}" Height="28" MinWidth="28" Padding="4,0"
                                    ToolTip="{u:T Main_Close}" Click="CloseDrawer_Click" />
                            <Button x:Name="DrawerClearButton" DockPanel.Dock="Right" Style="{StaticResource ToolButton}" Content="{u:T Drawer_ClearAll}" Height="28"
                                    IsEnabled="False" Click="ClearFilter_Click" />
                            <TextBlock Text="{u:T Main_Filter}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="16,10">
                        <DockPanel x:Name="DrawerFooter" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DrawerContent" Margin="16,12,16,8" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Popup x:Name="HoverTip" Placement="Relative" PlacementTarget="{Binding ElementName=Treemap}"
                   AllowsTransparency="True" IsHitTestVisible="False" StaysOpen="True" Focusable="False">
                <Border Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                        CornerRadius="8" Padding="12,8" Margin="0,0,10,10" MinWidth="200" MaxWidth="360">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.45" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="TipSize" DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource Text}" />
                            <TextBlock x:Name="TipName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Text}" />
                        </DockPanel>
                        <StackPanel x:Name="TipLines" Margin="0,2,0,0" />
                    </StackPanel>
                </Border>
            </Popup>

            <Grid x:Name="ScanOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed">
                <Border Width="800" Padding="30,24,30,22" CornerRadius="14" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <!-- title: what is scanned, the facts about it in dim beside, the percentage on the right -->
                        <DockPanel>
                            <TextBlock x:Name="ScanPercentText" DockPanel.Dock="Right" FontSize="24" FontWeight="Bold"
                                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="16,0,0,0" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run x:Name="ScanTitle" FontSize="24" FontWeight="Bold" />
                                <Run Text="   " />
                                <Run x:Name="ScanSubtitle" FontSize="13" Foreground="{DynamicResource TextDim}" />
                            </TextBlock>
                        </DockPanel>

                        <!-- the three stages: each a bar with its name under it; done, running, waiting -->
                        <Grid Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="2.4*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <Grid x:Name="StageFindBar" Height="6" ClipToBounds="True">
                                    <Border Background="{DynamicResource Control}" CornerRadius="3" />
                                    <Border x:Name="StageFindFill" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="6">
                                        <Border.RenderTransform><TranslateTransform x:Name="StageFindSweep" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <DockPanel Margin="0,8,0,0">
                                    <controls:Icon x:Name="StageFindIcon" Glyph="{StaticResource Icon.Loader}" Width="14" Height="14" StrokeWidth="2.4" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run x:Name="StageFindText" FontWeight="SemiBold" Text="{u:T Scan_StageFind}" />
                                        <Run x:Name="StageFindDetail" FontSize="11.5" Foreground="{DynamicResource TextDim}" />
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <Grid x:Name="StageBuildBar" Height="6" ClipToBounds="True">
                                    <Border Background="{DynamicResource Control}" CornerRadius="3" />
                                    <Border x:Name="StageBuildFill" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                                        <Border.RenderTransform><TranslateTransform x:Name="StageBuildSweep" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <DockPanel Margin="0,8,0,0">
                                    <controls:Icon x:Name="StageBuildIcon" Glyph="{StaticResource Icon.Circle}" Width="14" Height="14" StrokeWidth="2.4" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                        <Run x:Name="StageBuildText" FontWeight="SemiBold" Text="{u:T Scan_StageBuild}" />
                                        <Run x:Name="StageBuildDetail" FontSize="11.5" Foreground="{DynamicResource TextDim}" />
                                    </TextBlock>
                                </DockPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <Grid x:Name="StageDrawBar" Height="6" ClipToBounds="True">
                                    <Border Background="{DynamicResource Control}" CornerRadius="3" />
                                    <Border x:Name="StageDrawFill" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0">
                                        <Border.RenderTransform><TranslateTransform x:Name="StageDrawSweep" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <DockPanel Margin="0,8,0,0">
                                    <controls:Icon x:Name="StageDrawIcon" Glyph="{StaticResource Icon.Circle}" Width="14" Height="14" StrokeWidth="2.4" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="StageDrawText" FontWeight="SemiBold" Text="{u:T Scan_StageDraw}" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>

                        <!-- the numbers, big, in one row; Cancel on the right -->
                        <DockPanel Margin="0,22,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{u:T Main_EscAlsoCancels}" Foreground="{DynamicResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <Button x:Name="CancelButton" Style="{StaticResource ToolButton}" Tag="{StaticResource Icon.Close}"
                                        Content="{u:T Main_Cancel}" Click="Cancel_Click" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock x:Name="ScanSizeText" Text="0 B" FontSize="30" FontWeight="Bold" />
                                    <TextBlock x:Name="ScanSizeLabel" Text="{u:T Scan_FoundSoFar}" Foreground="{DynamicResource TextDim}" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel Margin="0,0,36,0">
                                    <TextBlock x:Name="ScanRateText" Text="0" FontSize="30" FontWeight="Bold" />
                                    <TextBlock Text="{u:T Scan_FilesPerSecond}" Foreground="{DynamicResource TextDim}" FontSize="11.5" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="ScanElapsedText" Text="0:00" FontSize="30" FontWeight="Bold" />
                                    <TextBlock x:Name="ScanElapsedLabel" Text="{u:T Scan_Elapsed}" Foreground="{DynamicResource TextDim}" FontSize="11.5" />
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>

                        <!-- the path the scan is at, on a hairline -->
                        <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
                            <TextBlock x:Name="ScanPathText" Foreground="{DynamicResource TextDim}" FontSize="12" FontFamily="Consolas, Cascadia Mono, Segoe UI"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
