<Window x:Class="SpaceSharp.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpaceSharp.Util"
        Title="{u:T SettingsWin_Settings}"
        Width="660" Height="760" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{u:T SettingsWin_Close}"
                        IsDefault="True" IsCancel="True" Click="Close_Click" />
                <Button Style="{StaticResource ToolButton}" Tag="&#xE777;" Content="{u:T SettingsWin_ResetToDefaults}"
                        HorizontalAlignment="Left" Click="Reset_Click" />
            </DockPanel>
        </Border>

        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="22,14,22,12">
            <StackPanel x:Name="TabBar" Orientation="Horizontal" />
        </Border>

        <Border x:Name="PreviewDock" DockPanel.Dock="Top" Visibility="Collapsed" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,0,0,1" Padding="28,14,28,8" Background="{DynamicResource Panel}">
            <ContentControl x:Name="PreviewHost" Focusable="False" />
        </Border>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel x:Name="Body" Margin="28,22,22,10" />
        </ScrollViewer>
    </DockPanel>
</Window>
