<Project Sdk="Microsoft.NET.Sdk">

  <!-- The app: the same map on Windows, macOS and Linux, drawn with Skia through Avalonia (Android and iOS are
       later heads on the same code). It references SpaceSharp.Core for everything that is not a window. -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SpaceSharp.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>SpaceSharp</AssemblyName>
    <RootNamespace>SpaceSharp</RootNamespace>
    <NeutralLanguage>en</NeutralLanguage>
    <RollForward>LatestMajor</RollForward>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Product>SpaceSharp</Product>
    <Version>2.5.0</Version>
    <PreviousVersion>2.4.1</PreviousVersion>   <!-- the release before this one -->
    <Authors>ClearanceClarence</Authors>
    <Company>ClearanceClarence</Company>
    <Copyright>© 2026 ClearanceClarence</Copyright>
    <RepositoryUrl>https://github.com/SpaceSharpApp/SpaceSharp</RepositoryUrl>
    <PackageProjectUrl>https://spacesharp.app/</PackageProjectUrl>
    <Description>See where your disk space went. SpaceSharp maps every file and folder as a box sized by the space it uses, so the biggest ones stand out.</Description>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="PreviousVersion" Value="$(PreviousVersion)" />
  </ItemGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <!-- A 32-bit process has a few gigabytes of address space in all; background GC reserves part of it for
         itself, so the x86 build does without. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
    <!-- The changelog travels inside the app, so What's new for the running version needs no network. -->
    <EmbeddedResource Include="..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach the app's internals (the Core project grants its own). -->
    <InternalsVisibleTo Include="SpaceSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.*" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.*" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.*" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.*" />
    <PackageReference Include="Velopack" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpaceSharp.Core\SpaceSharp.Core.csproj" />
  </ItemGroup>

</Project>
