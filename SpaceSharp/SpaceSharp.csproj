<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SpaceSharp.ico</ApplicationIcon>
    <AssemblyName>SpaceSharp</AssemblyName>
    <RootNamespace>SpaceSharp</RootNamespace>
    <!-- Program.Main runs Velopack's install/update hooks before WPF starts. -->
    <StartupObject>SpaceSharp.Program</StartupObject>
    <!-- No SatelliteResourceLanguages here: it would also filter the translations, which now come from
         SpaceSharp.Core as satellite assemblies, down to English. Velopack ships no satellites, so nothing is lost. -->
    <!-- Strings.resx is English, so the resource manager never looks for an English satellite assembly first. -->
    <NeutralLanguage>en</NeutralLanguage>
    <!-- The Small build runs on a newer major runtime when .NET 10 is gone from the PC, instead of refusing to start. -->
    <RollForward>LatestMajor</RollForward>
    <!-- Keep the version shown in About exactly <Version>, without the "+commit" the SDK appends from git. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Same bytes for the same source on any machine, and CI builds carry no local paths. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Have the IDE rules in .editorconfig checked at build time too, at their configured severity. -->
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>

    <!-- Shown in the About window and in the .exe's file properties. -->
    <Product>SpaceSharp</Product>
    <Version>2.2.0</Version>
    <Authors>ClearanceClarence</Authors>
    <Company>ClearanceClarence</Company>
    <Copyright>© 2026 ClearanceClarence</Copyright>
    <RepositoryUrl>https://github.com/SpaceSharpApp/SpaceSharp</RepositoryUrl>
    <PackageProjectUrl>https://spacesharp.app/</PackageProjectUrl>
    <Description>See where your disk space went. SpaceSharp maps every file and folder as a box sized by the space it uses, so the biggest ones stand out.</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x86'">
    <!-- A 32-bit process has a few gigabytes of address space in all; background GC reserves part of it for
         itself, so the x86 build does without. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF projects drop System.IO from the implicit usings (it clashes with
         System.Windows.Shapes.Path), so add it back globally. -->
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer and auto-update framework. -->
    <PackageReference Include="Velopack" Version="*" />
  </ItemGroup>

  <ItemGroup>
    <!-- The platform-neutral half: tree, layout, saved scans, strings, sizes. See SpaceSharp.Core/SpaceSharp.Core.csproj. -->
    <ProjectReference Include="..\SpaceSharp.Core\SpaceSharp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the test project reach the app's internals (the Core project grants its own). -->
    <InternalsVisibleTo Include="SpaceSharp.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Icon files embedded for the window icon and the About window. -->
    <None Remove="Assets\SpaceSharp.ico" />
    <None Remove="Assets\SpaceSharp-256.png" />
    <Resource Include="Assets\SpaceSharp.ico" />
    <Resource Include="Assets\SpaceSharp-256.png" />
  </ItemGroup>

</Project>
