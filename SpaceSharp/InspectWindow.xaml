<Window x:Class="SpaceSharp.InspectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:u="clr-namespace:SpaceSharp.Util"
        xmlns:c="clr-namespace:SpaceSharp.Controls"
        Title="{u:T InspectWin_Inspect}"
        Width="660" Height="880" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="/Assets/SpaceSharp.ico"
        Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextDim}" />
            <Setter Property="Margin" Value="0,18,0,8" />
        </Style>
        <Style x:Key="LegendRow" TargetType="Border">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Control}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Footer: actions -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}"
                BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="{u:T InspectWin_Close}" MinWidth="84"
                        IsDefault="True" IsCancel="True" Click="Close_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Style="{StaticResource ToolButton}" Tag="&#xE8C8;" Content="{u:T InspectWin_CopyDetails}" Click="Copy_Click" />
                    <Button x:Name="ExplorerButton" Style="{StaticResource ToolButton}" Tag="&#xE838;" Content="{u:T InspectWin_ShowInExplorer}"
                            Margin="6,0,0,0" Click="Explorer_Click" />
                    <Button x:Name="PropertiesButton" Style="{StaticResource ToolButton}" Tag="&#xE946;" Content="{u:T InspectWin_Properties}"
                            Margin="6,0,0,0" Click="Properties_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Header: stays put while the rest scrolls -->
        <Border DockPanel.Dock="Top" Padding="24,16,24,16" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1">
            <StackPanel>
                <WrapPanel x:Name="Crumbs" Margin="-6,0,0,6" />
                <DockPanel>
                    <TextBlock x:Name="Glyph" DockPanel.Dock="Left" FontFamily="{StaticResource IconFont}" FontSize="22"
                               Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,12,0" Text="&#xE8B7;" />
                    <TextBlock x:Name="SizeText" DockPanel.Dock="Right" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center"
                               Margin="16,0,0,0" ToolTipService.InitialShowDelay="300" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="KindText" Foreground="{DynamicResource TextDim}" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DockPanel>
                <Grid x:Name="Context" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel Margin="24,14,24,20">
                <Border x:Name="Callout" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="3,0,0,0"
                        Padding="12,9" Margin="0,2,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="CalloutText" TextWrapping="Wrap" FontSize="12.5" />
                </Border>

                <Grid x:Name="Charts">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="TypePanel" Grid.Column="0">
                        <TextBlock Style="{StaticResource SectionHeading}" Text="{u:T Inspect_ByType}" />
                        <DockPanel>
                            <c:DonutChart x:Name="TypeDonut" DockPanel.Dock="Left" Width="104" Height="104" Thickness="17" VerticalAlignment="Top" Margin="0,2,14,0"
                                          TextBrush="{DynamicResource Text}" DimBrush="{DynamicResource TextDim}" TrackBrush="{DynamicResource Control}" />
                            <StackPanel x:Name="TypeLegend" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <StackPanel x:Name="AgePanel" Grid.Column="2">
                        <TextBlock Style="{StaticResource SectionHeading}" Text="{u:T Inspect_ByAge}" />
                        <DockPanel>
                            <c:DonutChart x:Name="AgeDonut" DockPanel.Dock="Left" Width="104" Height="104" Thickness="17" VerticalAlignment="Top" Margin="0,2,14,0"
                                          TextBrush="{DynamicResource Text}" DimBrush="{DynamicResource TextDim}" TrackBrush="{DynamicResource Control}" />
                            <StackPanel x:Name="AgeLegend" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock x:Name="OldestText" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="LargestPanel">
                    <TextBlock x:Name="LargestHeading" Style="{StaticResource SectionHeading}" Text="{u:T Inspect_WhereTheSpaceIs}" />
                    <StackPanel x:Name="LargestRows" />
                    <TextBlock x:Name="RemainderText" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
