<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="using:SpaceSharp.Controls"
        x:Class="SpaceSharp.MainWindow"
        Title="SpaceSharp"
        Width="1400" Height="880" MinWidth="1040" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        Icon="avares://SpaceSharp.Avalonia/Assets/SpaceSharp-256.png"
        Background="{DynamicResource Window}">

  <!-- The Windows app's main window, laid out the same way: top bar, path row, the filter rail under it, the side
       panel with drives and largest items, the map (or the start screen, the Insights view, the scan card), and
       the status bar. The text is set in Build() from the same Strings.resx. -->

  <DockPanel>
    <!-- ============================================================ top bar -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="10,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock x:Name="ColorLabel" Classes="dim" VerticalAlignment="Center" Margin="0,0,8,0" />
          <ComboBox x:Name="ColorCombo" Width="130" SelectionChanged="ColorMode_Changed" />
          <TextBlock x:Name="PaletteLabel" Classes="dim" VerticalAlignment="Center" Margin="14,0,8,0" />
          <ComboBox x:Name="PaletteCombo" Width="250" MaxDropDownHeight="640" SelectionChanged="Palette_Changed" />
          <Border Classes="divider" />
          <Button x:Name="SettingsButton" Classes="tool" Margin="0,0,6,0" Click="Settings_Click"><controls:Icon Glyph="{StaticResource Icon.Settings}" Width="15" Height="15" /></Button>
          <Button x:Name="ThemeButton" Classes="tool" Margin="0,0,6,0" Click="Theme_Click"><controls:Icon x:Name="ThemeIcon" Glyph="{StaticResource Icon.Moon}" Width="15" Height="15" /></Button>
          <Button x:Name="AboutButton" Classes="tool" Click="About_Click"><controls:Icon Glyph="{StaticResource Icon.Info}" Width="15" Height="15" /></Button>
        </StackPanel>

        <StackPanel Orientation="Horizontal">
          <Button x:Name="ScanFolderButton" Classes="primary" Click="ScanFolder_Click" />
          <Button x:Name="RescanButton" Classes="tool" Margin="6,0,6,0" Click="Rescan_Click"><controls:Icon Glyph="{StaticResource Icon.Refresh}" Width="15" Height="15" /></Button>
          <Border Classes="divider" />
          <Button x:Name="UpButton" Classes="tool" Margin="0,0,6,0" Click="Up_Click"><controls:Icon Glyph="{StaticResource Icon.Up}" Width="15" Height="15" /></Button>
          <Button x:Name="HomeButton" Classes="tool" Margin="0,0,6,0" Click="Fit_Click"><controls:Icon Glyph="{StaticResource Icon.Home}" Width="15" Height="15" /></Button>
          <Button x:Name="PanelButton" Classes="tool" Margin="0,0,6,0" Click="Panel_Click"><controls:Icon Glyph="{StaticResource Icon.SidePanel}" Width="15" Height="15" /></Button>
          <Border Classes="divider" />
          <Button x:Name="MapViewButton" Classes="primary" Margin="0,0,2,0" Padding="10,0" Click="MapView_Click" />
          <Button x:Name="InsightsButton" Classes="tool" Margin="0,0,6,0" Padding="10,0" Click="InsightsView_Click" />
          <Border Classes="divider" />
          <Button x:Name="ZoomOutButton" Classes="tool" Margin="0,0,6,0" Click="ZoomOut_Click"><controls:Icon Glyph="{StaticResource Icon.ZoomOut}" Width="15" Height="15" /></Button>
          <TextBlock x:Name="ZoomLabel" Width="64" TextAlignment="Center" VerticalAlignment="Center" Classes="dim" Text="—" Margin="0,0,6,0" />
          <Button x:Name="ZoomInButton" Classes="tool" Margin="0,0,6,0" Click="ZoomIn_Click"><controls:Icon Glyph="{StaticResource Icon.ZoomIn}" Width="15" Height="15" /></Button>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============================================================ protected folders notice -->
    <Border x:Name="AccessBar" DockPanel.Dock="Top" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="4,0,0,1" Padding="12,6">
      <DockPanel>
        <Button x:Name="AccessCloseButton" DockPanel.Dock="Right" Classes="tool" Height="28" Click="CloseAccessBar_Click"><controls:Icon Glyph="{StaticResource Icon.Close}" Width="15" Height="15" /></Button>
        <Button x:Name="AccessRestartButton" DockPanel.Dock="Right" Classes="primary" Height="28" Margin="12,0,6,0" Click="RestartElevated_Click" />
        <TextBlock x:Name="AccessText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ============================================================ path row -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource Window}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="6,4" MinHeight="36">
      <DockPanel>
        <!-- The filter text lives here, hidden: shortcuts, presets and both filter faces all write to it. -->
        <TextBox x:Name="FilterBox" IsVisible="False" Width="0" TextChanged="FilterBox_TextChanged" />
        <Button x:Name="FilterToggleButton" DockPanel.Dock="Right" Classes="tool" Height="28" Margin="12,0,4,0" Click="FilterToggle_Click" />
        <TextBlock x:Name="BreadcrumbInfo" DockPanel.Dock="Right" Classes="dim" VerticalAlignment="Center" Margin="12,0,4,0" />
        <StackPanel x:Name="Crumbs" Orientation="Horizontal" ClipToBounds="True" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <!-- ============================================================ filter rail (Settings › Map › Filter layout: Rail) -->
    <Border DockPanel.Dock="Top" x:Name="FilterRail" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="12,7">
      <DockPanel x:Name="RailContent" LastChildFill="False" />
    </Border>

    <!-- ============================================================ status bar -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Classes="dim" Margin="16,0,0,0" />
        <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- ============================================================ side panel -->
    <Border x:Name="SidePanel" DockPanel.Dock="Left" Width="300" MinWidth="220" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,*">
        <TextBlock x:Name="DrivesTitle" Grid.Row="0" FontSize="15" FontWeight="SemiBold" Margin="14,12,14,4" />
        <TextBlock x:Name="DrivesHint" Grid.Row="1" Classes="dim" FontSize="12" Margin="14,0,14,4" />
        <ScrollViewer x:Name="DriveScroller" Grid.Row="2" MaxHeight="320" MinHeight="72">
          <StackPanel x:Name="DriveList" Margin="8,0" Spacing="1" />
        </ScrollViewer>
        <Border Grid.Row="3" Height="1" Margin="14,8,14,4" Background="{DynamicResource Stroke}" />
        <TextBlock x:Name="ListsTitle" Grid.Row="4" FontSize="15" FontWeight="SemiBold" Margin="14,4,14,2" />
        <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="10,4,10,4">
          <Button x:Name="ListFilesButton" Classes="tab" Height="28" Click="ListKind_Click" Tag="Files" />
          <Button x:Name="ListFoldersButton" Classes="tab" Height="28" Click="ListKind_Click" Tag="Folders" />
          <Button x:Name="ListTypesButton" Classes="tab" Height="28" Click="ListKind_Click" Tag="Types" />
          <Button x:Name="ListChangesButton" Classes="tab" Height="28" Click="ListKind_Click" Tag="Changes" IsVisible="False" />
        </StackPanel>
        <TextBlock x:Name="ListHint" Grid.Row="6" Classes="dim" FontSize="12" Margin="14,0,14,6" TextTrimming="CharacterEllipsis" />
        <ScrollViewer Grid.Row="7">
          <StackPanel x:Name="TopList" Margin="8,0,8,8" Spacing="1" />
        </ScrollViewer>
      </Grid>
    </Border>

    <!-- ============================================================ map -->
    <Grid x:Name="MapHost" Background="{DynamicResource Window}">
      <controls:TreemapControl x:Name="Treemap" MapBackground="{DynamicResource MapBackground}" />

      <!-- the Insights view, in the map's place -->
      <ScrollViewer x:Name="InsightsView" IsVisible="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="{DynamicResource Window}" SizeChanged="InsightsView_SizeChanged">
        <StackPanel x:Name="InsightsHost" Margin="18,16,22,18" />
      </ScrollViewer>

      <!-- start screen: pick a drive, or pick up where you left off -->
      <Grid x:Name="EmptyHint">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="900">
          <DockPanel Margin="4,0">
            <TextBlock x:Name="EmptyTotals" DockPanel.Dock="Right" Classes="dim" FontSize="12.5" VerticalAlignment="Bottom" Margin="24,0,0,4" />
            <Image DockPanel.Dock="Left" Source="avares://SpaceSharp.Avalonia/Assets/SpaceSharp-256.png" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="EmptyTitle" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock x:Name="EmptyText" Classes="dim" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap" />
            </StackPanel>
          </DockPanel>
          <WrapPanel x:Name="RecentTiles" Margin="0,18,0,0" HorizontalAlignment="Center" />
          <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
            <Button x:Name="EmptyScanButton" Grid.Column="0" Classes="start" Margin="0,0,6,0" Click="ScanFolder_Click">
              <Grid><Rectangle Classes="dash" /><StackPanel x:Name="EmptyScanContent" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
            <Button x:Name="EmptyOpenButton" Grid.Column="1" Classes="start" Margin="6,0,0,0" Click="OpenScan_Click">
              <Grid><Rectangle Classes="dash" /><StackPanel x:Name="EmptyOpenContent" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" /></Grid>
            </Button>
          </Grid>
        </StackPanel>
      </Grid>

      <!-- the hover tooltip: placed beside the pointer by code -->
      <Border x:Name="HoverTip" IsVisible="False" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"
              Background="{DynamicResource MenuBg}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="8" Padding="12,8"
              MinWidth="200" MaxWidth="360" BoxShadow="0 3 14 0 #73000000">
        <StackPanel>
          <DockPanel>
            <TextBlock x:Name="TipSize" DockPanel.Dock="Right" FontSize="14" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TipName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
          </DockPanel>
          <StackPanel x:Name="TipLines" Margin="0,2,0,0" />
        </StackPanel>
      </Border>

      <!-- the filter drawer (the default filter layout): a sheet over the right of the map -->
      <Border x:Name="FilterDrawer" HorizontalAlignment="Right" Width="380" IsVisible="False" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1,0,0,0" BoxShadow="0 0 24 0 #80000000">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,0,0,1" Padding="16,0" Height="44">
            <DockPanel>
              <Button x:Name="DrawerCloseButton" DockPanel.Dock="Right" Classes="tool" Height="28" MinWidth="28" Padding="4,0" Click="CloseDrawer_Click"><controls:Icon Glyph="{StaticResource Icon.Close}" Width="15" Height="15" /></Button>
              <Button x:Name="DrawerClearButton" DockPanel.Dock="Right" Classes="tool" Height="28" IsEnabled="False" Click="ClearFilter_Click" />
              <TextBlock x:Name="DrawerTitle" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
          </Border>
          <Border DockPanel.Dock="Bottom" Background="{DynamicResource Window}" BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel x:Name="DrawerFooter" />
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DrawerContent" Margin="16,12,16,8" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- while scanning: the card over a scrim -->
      <Grid x:Name="ScanCard" IsVisible="False" Background="{DynamicResource Scrim}">
        <Border Width="800" Padding="30,24,30,22" CornerRadius="14" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Center" BoxShadow="0 8 28 0 #80000000">
          <StackPanel>
            <DockPanel>
              <TextBlock x:Name="ScanPercent" DockPanel.Dock="Right" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="16,0,0,0" />
              <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                <TextBlock x:Name="ScanTitle" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBlock x:Name="ScanSubtitle" Grid.Column="1" Classes="dim" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" />
              </Grid>
            </DockPanel>

            <!-- the three stages: each a bar with its name under it -->
            <Grid Margin="0,20,0,0" ColumnDefinitions="1.2*,6,2.4*,6,*">
              <StackPanel Grid.Column="0">
                <Grid x:Name="StageFindBar" Height="6" ClipToBounds="True">
                  <Border Background="{DynamicResource Control}" CornerRadius="3" />
                  <Border x:Name="StageFindFill" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="6" />
                </Grid>
                <DockPanel Margin="0,8,0,0">
                  <controls:Icon x:Name="StageFindIcon" DockPanel.Dock="Left" Glyph="{StaticResource Icon.Loader}" Width="14" Height="14" StrokeWidth="2.4" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run x:Name="StageFindText" FontWeight="SemiBold" /><Run Text=" " /><Run x:Name="StageFindDetail" FontSize="11.5" Foreground="{DynamicResource TextDim}" /></TextBlock>
                </DockPanel>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <Grid x:Name="StageBuildBar" Height="6" ClipToBounds="True">
                  <Border Background="{DynamicResource Control}" CornerRadius="3" />
                  <Border x:Name="StageBuildFill" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                </Grid>
                <DockPanel Margin="0,8,0,0">
                  <controls:Icon x:Name="StageBuildIcon" DockPanel.Dock="Left" Glyph="{StaticResource Icon.Circle}" Width="14" Height="14" StrokeWidth="2.4" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis"><Run x:Name="StageBuildText" FontWeight="SemiBold" /><Run Text=" " /><Run x:Name="StageBuildDetail" FontSize="11.5" Foreground="{DynamicResource TextDim}" /></TextBlock>
                </DockPanel>
              </StackPanel>
              <StackPanel Grid.Column="4">
                <Grid x:Name="StageDrawBar" Height="6" ClipToBounds="True">
                  <Border Background="{DynamicResource Control}" CornerRadius="3" />
                  <Border x:Name="StageDrawFill" Background="{DynamicResource Accent}" CornerRadius="3" HorizontalAlignment="Left" Width="0" />
                </Grid>
                <DockPanel Margin="0,8,0,0">
                  <controls:Icon x:Name="StageDrawIcon" DockPanel.Dock="Left" Glyph="{StaticResource Icon.Circle}" Width="14" Height="14" StrokeWidth="2.4" Foreground="{DynamicResource TextDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                  <TextBlock x:Name="StageDrawText" FontWeight="SemiBold" Classes="dim" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
              </StackPanel>
            </Grid>

            <!-- the numbers, big, in one row; Cancel on the right -->
            <DockPanel Margin="0,22,0,0">
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <TextBlock x:Name="CancelHint" Classes="dim" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Button x:Name="CancelButton" Classes="tool" Click="Cancel_Click" />
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,36,0">
                  <TextBlock x:Name="ScanSize" Text="0 B" FontSize="30" FontWeight="Bold" />
                  <TextBlock x:Name="ScanSizeLabel" Classes="dim" FontSize="11.5" />
                </StackPanel>
                <StackPanel Margin="0,0,36,0">
                  <TextBlock x:Name="ScanRate" Text="0" FontSize="30" FontWeight="Bold" />
                  <TextBlock x:Name="ScanRateLabel" Classes="dim" FontSize="11.5" />
                </StackPanel>
                <StackPanel>
                  <TextBlock x:Name="ScanElapsed" Text="0:00" FontSize="30" FontWeight="Bold" />
                  <TextBlock x:Name="ScanElapsedLabel" Classes="dim" FontSize="11.5" />
                </StackPanel>
              </StackPanel>
            </DockPanel>

            <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="0,1,0,0" Margin="0,16,0,0" Padding="0,10,0,0">
              <TextBlock x:Name="ScanPath" Classes="dim" FontSize="12" FontFamily="Cascadia Mono, Consolas, Menlo, monospace" TextTrimming="CharacterEllipsis" />
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
