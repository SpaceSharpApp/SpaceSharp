<Project Sdk="Microsoft.NET.Sdk">

  <!-- The part of SpaceSharp that knows nothing about Windows or Avalonia: the tree, the layout, saved scans,
       the strings and their translations, sizes, the command line. It is what the Mac, Linux and Android builds
       share with the Windows app. Nothing in here may reference Avalonia, Velopack or Win32; the project
       targets plain net10.0 with no UI package so the compiler enforces that. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Same namespaces and resource names as before the split, so the app and the tests needed no renames. -->
    <RootNamespace>SpaceSharp</RootNamespace>
    <AssemblyName>SpaceSharp.Core</AssemblyName>
    <NeutralLanguage>en</NeutralLanguage>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>   <!-- validates the XML docs; CS1591 for an undocumented public member -->
    <Product>SpaceSharp</Product>
    <Authors>ClearanceClarence</Authors>
    <Company>ClearanceClarence</Company>
    <Copyright>© 2026 ClearanceClarence</Copyright>
    <RepositoryUrl>https://github.com/SpaceSharpApp/SpaceSharp</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- The file type table; its header says how to add a type. -->
    <EmbeddedResource Include="Resources\FileTypes.txt" LogicalName="SpaceSharp.Resources.FileTypes.txt" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scanners set sizes and dates on FsNode; the tests build trees the same way. -->
    <InternalsVisibleTo Include="SpaceSharp" />
    <InternalsVisibleTo Include="SpaceSharp.Tests" />
  </ItemGroup>

</Project>
